#!/bin/sh
# Keep docs/rules/README.md's derived sections in sync with the topic docs. Runs only when a
# commit touches the rules docs; regenerates the index and re-stages it so the fix lands in the
# same commit. CI's `check_rules_derive.py --check` is the backstop, not the front line.
if git diff --cached --name-only | grep -q '^docs/rules/'; then
    python3 scripts/check_rules_derive.py --write "$(git rev-parse --show-toplevel)" || {
        echo "pre-commit: rules index has a structural problem (see above)" >&2
        exit 1
    }
    git add docs/rules/README.md
fi

# The rules reference-linter: no ADR number survives in code, no comment cites an issue or a rule
# anchor, and every `see rules: <topic>` pointer resolves and stops at its topic. Same split as
# above — CI's always-on `ref-guard` job is the backstop, this is the front line — but with no path
# filter: a reintroduced ADR ref or a broken pointer can hide in ANY code change, so it runs on
# every commit.
#
# Run whole-tree, never over the staged subset, for two measured reasons. A whole-tree run costs
# 0.716s over the current tree, so scoping it buys nothing worth the plumbing. And check 7
# (`suffix_class_problems`) is inherently whole-tree — it enumerates every lane key in the repo and
# requires each to be classified, so handing it a staged subset silently weakens it.
python3 scripts/check_rules_refs.py "$(git rev-parse --show-toplevel)" || {
    echo "pre-commit: rules reference-linter failed (see above)" >&2
    exit 1
}
