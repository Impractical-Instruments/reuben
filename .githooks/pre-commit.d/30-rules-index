#!/bin/sh
# Keep docs/rules/README.md's derived sections in sync with the topic docs. Runs only when a
# commit touches the rules docs; regenerates the index and re-stages it so the fix lands in the
# same commit. CI's `check_rules_derive.py --check` is the backstop, not the front line.
#
# Numbered last on purpose, and the number is the whole mechanism: this is the only check in the
# pre-commit set that WRITES. A read-only check that fails after it would leave the author a
# modified, staged README they never touched and were never told about. So read-only checks take
# the low numbers and writers take the high ones — see CONTRIBUTING.md.
if ! command -v python3 >/dev/null 2>&1; then
    if git diff --cached --name-only | grep -q '^docs/rules/'; then
        echo "! pre-commit: python3 not found — the rules index was NOT regenerated." >&2
        echo "  CI's derive --check will red this commit. See CONTRIBUTING.md (Toolchain)." >&2
    fi
    exit 0
fi

if git diff --cached --name-only | grep -q '^docs/rules/'; then
    python3 scripts/check_rules_derive.py --write "$(git rev-parse --show-toplevel)" || {
        echo "pre-commit: rules index has a structural problem (see above)" >&2
        exit 1
    }
    git add docs/rules/README.md
fi
