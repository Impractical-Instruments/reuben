#!/bin/sh
# Run every check registered for one git hook, in name order, and stop at the first failure.
#
# `core.hooksPath` holds ONE directory and a hook type is ONE file, so two sets of checks cannot
# both be installed — the second silently replaces the first. This file is the indirection that
# removes the choice: `.githooks/pre-commit` and `.githooks/pre-push` are stubs that call it with
# their own name, and each check is a separate executable under `.githooks/<hook>.d/`. Adding a
# check is adding a file; it never displaces one.
# see rules: web-product-process
#
# What a check may assume:
#   - it runs from the working-tree root, with the hook's own arguments
#   - it is handed the hook's stdin verbatim (git gives pre-push its pushed refs there)
#   - a non-zero exit aborts the hook, and later checks do not run
#   - it may stage files; `git commit --no-verify` / `git push --no-verify` bypasses the whole set
#
# Nothing in this file knows anything about this repository. Every repo-specific fact is in a
# registry entry.
set -eu

hook=${1:-}
if [ -z "$hook" ]; then
    echo "dispatch: called without a hook name — see .githooks/pre-commit for the calling form" >&2
    exit 1
fi
shift

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
registry="$here/$hook.d"
[ -d "$registry" ] || exit 0

# Every check has to see the same stdin, and stdin can only be read once — so capture it to a file
# and redirect each check from that. A terminal on stdin means a human ran the hook by hand:
# reading it would block forever, so the checks get /dev/null instead.
replay=/dev/null
if [ ! -t 0 ]; then
    replay=$(mktemp "${TMPDIR:-/tmp}/githook-stdin.XXXXXX")
    trap 'rm -f "$replay"' EXIT HUP INT TERM
    cat >"$replay"
fi

status=0
for check in "$registry"/*; do
    # An editor's backup copy inherits the executable bit from the file it shadows, so without this
    # the set would silently run a stale duplicate of a check. It is the one name-based exclusion,
    # and it is here because that hazard is real rather than to reserve a convention.
    case "$check" in
        *~) continue ;;
    esac
    # A registry with no entries leaves the glob unexpanded, which is not a file. A directory in
    # the registry is not a check either.
    [ -f "$check" ] || continue

    # A check that lost its executable bit is a check that does not run, and stepping over it
    # quietly would rebuild the failure this whole arrangement exists to prevent: a guard wired to
    # something nothing executes, reporting nothing, and therefore reading as clean. Refuse instead.
    # Retiring a check is deleting the file, which review can see; skipping one run is --no-verify.
    if [ ! -x "$check" ]; then
        echo "✗ $hook: $hook.d/${check##*/} is not executable, so it would never run." >&2
        echo "  Fix:    ./scripts/install-hooks.sh" >&2
        echo "  Bypass: --no-verify (this run only)" >&2
        exit 1
    fi

    rc=0
    "$check" "$@" <"$replay" || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo >&2
        echo "✗ $hook: $hook.d/${check##*/} failed — the $hook hook is aborting." >&2
        status=$rc
        break
    fi
done

exit "$status"
